# 本地默认使用 PostgreSQL，改成你自己的连接信息
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/soulsearching

# 音频/封面文件根目录，默认是 backend/media，一般无需修改
# MEDIA_ROOT=./media

# 允许跨域访问 API 的前端地址
# CORS_ORIGINS=["http://localhost:3000"]

# 管理后台与上传接口的账号（生产环境务必修改）
# SECRET_KEY=change-me
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
