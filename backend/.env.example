# PostgreSQL 连接串：用户名、密码、数据库名按你的实际配置修改
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/database

# 音频/封面/下载包文件根目录，默认是 backend/media，一般无需修改
# MEDIA_ROOT=./media

# 上传文件大小上限（MB）
# MAX_UPLOAD_MB=512

# 允许跨域访问 API 的前端地址
# CORS_ORIGINS=["http://localhost:3000"]

# 运行环境：development（默认）或 production
# production 下若 SECRET_KEY / 管理账号仍为默认值，后端会拒绝启动
# APP_ENV=production

# 管理后台与上传接口的账号（生产环境务必修改）
# SECRET_KEY=change-me
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
